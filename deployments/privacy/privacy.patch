+const labels = {
+  pl: ["Polityka prywatności", "Usuń konto"],
+  en: ["Privacy policy", "Delete account"],
+  nl: ["Privacybeleid", "Account verwijderen"],
+  fr: ["Politique de confidentialité", "Supprimer le compte"],
+  de: ["Datenschutzerklärung", "Konto löschen"],
+};
+
+export function PrivacyLinks() {
+  const { lang } = useI18n();
+  const [privacy, deletion] = labels[lang];
+  const section = lang === "pl" ? "pl" : "en";
+  return (
+    <div className="flex flex-wrap gap-x-5 gap-y-2 text-sm">
+      <a href={`/privacy#${section}`} className="text-foreground/80 hover:text-gold hover:underline">
+        {privacy}
+      </a>
+      <a href={`/delete-account#${section}`} className="text-foreground/80 hover:text-gold hover:underline">
+        {deletion}
+      </a>
+    </div>
+  );
+}
