+<!doctype html>
+<html lang="pl">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Polityka prywatności | Marka Centrum Akademy</title>
+<meta name="description" content="Prywatność użytkowników Marka Centrum Akademy.">
+<style>
+:root{color-scheme:dark;font:17px/1.65 system-ui,sans-serif;background:#111;color:#f2eee4}
+*{box-sizing:border-box}body{margin:0}main{max-width:49rem;margin:auto;padding:2rem 1.2rem 4rem}
+a{color:#f1ce7f;text-underline-offset:.18em;overflow-wrap:anywhere}a:focus-visible{outline:2px solid #fff;outline-offset:4px}
