+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { checkout } from "../src/lib/mca-checkout.server.ts";
+import { isPlayPurchaseSurface } from "../src/lib/mca-purchase-surface.ts";
+
+const origin = "https://staging.example.invalid";
+const basic = "11111111-1111-4111-8111-111111111111";
+const renovation = "f166433e-5157-4341-9a38-800c62795ebd";
+const user = "bbbbbbbb-dddd-4222-8111-444444444444";
+const order = "aaaaaaaa-eeee-4333-8111-333333333333";
+const endpoint = "/api/academy/checkout";
+
+function request(courseId = basic, options = {}) {
+  const headers = { Origin: origin, Authorization: "Bearer local-fixture", "Content-Type": "application/json" };
+  return new Request(origin + endpoint, {
+    method: "POST",
+    headers: { ...headers, ...options.headers },
+    body: options.body ?? JSON.stringify({ courseId }),
+  });
+}
+
+function fixture(t, { prepare, mutate, authStatus = 200, bindStatus = 200 } = {}) {
+  const env = {
+    MCA_CHECKOUT_ORIGIN: origin, STRIPE_SECRET_KEY: "rk_test_localfixture",
+    STRIPE_PRICE_BASIC: "price_basic120", STRIPE_PRICE_RENOVATION: "price_renovation120",
+    STRIPE_WEBHOOK_SECRET: "whsec_localfixture",
+    SUPABASE_URL: "https://backend.example.invalid/subpath/", SUPABASE_PUBLISHABLE_KEY: "test-public",
+    SUPABASE_SERVICE_ROLE_KEY: "sb_secret_localfixture",
+  };
+  const original = Object.fromEntries(Object.keys(env).map(k => [k, process.env[k]]));
+  Object.assign(process.env, env);
+  t.after(() => {
+    for (const [key, value] of Object.entries(original)) {
+      if (value === undefined) delete process.env[key]; else process.env[key] = value;
+    }
+  });
+
+  const calls = [];
+  const orders = new Map();
+  const sessions = new Map();
+  const expiry = Math.floor(Date.now()/1000) + 23 * 3600;
+  t.mock.method(globalThis, "fetch", async (input, init) => {
+    const path = new URL(input).pathname;
+    const headers = new Headers(init.headers);
+    calls.push({ path, headers, body: init.body, method: init.method });
+    let response;
+    if (path === "/subpath/auth/v1/user") {
+      assert.equal(headers.get("authorization"), "Bearer local-fixture");
+      assert.equal(headers.get("apikey"), env.SUPABASE_PUBLISHABLE_KEY);
+      return Response.json({ id: user }, { status: authStatus });
+    }
+    if (path.includes("/rest/v1/rpc/")) {
+      assert.equal(headers.get("apikey"), env.SUPABASE_SERVICE_ROLE_KEY);
+      assert.equal(headers.get("authorization"), null);
+      const rpc = path.split("/").at(-1);
+      const p = JSON.parse(init.body);
+      if (rpc === "mca_prepare_checkout") {
+        assert.deepEqual(p, { p_user_id: user, p_course_id: p.p_course_id, p_live: false });
+        const info = orders.get(p.p_course_id) ?? {
+          status: "pending", order_id: order, expires_at: expiry, session_id: null, slug: "roof-work",
+        };
+        orders.set(p.p_course_id, info);
+        response = prepare?.(info, p) ?? info;
+      } else if (rpc === "mca_bind_checkout") {
+        for (const record of orders.values()) if (record.order_id === p.p_order_id) record.session_id = p.p_session_id;
+        return Response.json(null, { status: bindStatus });
+      } else if (rpc === "mca_expire_checkout") {
+        for (const record of orders.values()) {
+          if (record.session_id === p.p_session_id) {
+            record.order_id = "dddddddd-eeee-4333-8111-333333333333";
+            record.session_id = null;
+          }
+        }
+        response = null;
+      } else assert.fail("unexpected RPC");
+    } else if (path === "/v1/checkout/sessions") {
+      assert.equal(init.method, "POST");
+      const p = init.body;
+      assert.equal(headers.get("idempotency-key"), "mca-course-v1-" + p.get("client_reference_id"));
+      assert.equal(p.get("success_url"), origin + "/kurs/roof-work?mca_payment=return");
+      assert.equal(p.get("cancel_url"), origin + "/kurs/roof-work");
+      assert.equal(p.get("expires_at"), String(expiry));
+      assert.equal(p.get("mode"), "payment");
+      assert.equal(p.get("line_items[0][quantity]"), "1");
+      assert.equal(p.get("adaptive_pricing[enabled]"), "false");
+      assert.equal(p.get("metadata[user_id]"), user);
+      const id = "cs_test_" + p.get("client_reference_id");
+      const metadata = Object.fromEntries(["course_id", "user_id", "mca_order_id", "integration"].map(k => [k, p.get("metadata[" + k + "]")]));
+      assert.equal(metadata.integration, "mca_courses_v1");
+      assert.equal(metadata.mca_order_id, p.get("client_reference_id"));
+      const session = { id, metadata, client_reference_id: p.get("client_reference_id"), mode: "payment",
+        livemode: false, amount_total: 12000, currency: "eur", status: "open", url: "https://checkout.stripe.com/c/pay/" + id };
+      sessions.set(id, session);
+      response = mutate?.(session) ?? session;
+    } else if (path.startsWith("/v1/checkout/sessions/")) {
+      assert.equal(init.method, "GET");
+      response = sessions.get(decodeURIComponent(path.split("/").at(-1)));
+      assert.ok(response);
+    } else assert.fail("unexpected request");
+    return Response.json(response);
+  });
+  return { calls, sessions, orders };
+}
+
+for (const [courseId, priceId] of [[basic, "price_basic120"], [renovation, "price_renovation120"]]) {
+  test("authenticates and binds only the selected one-off course " + priceId, async t => {
+    const { calls } = fixture(t);
+    const res = await checkout(request(courseId, { body: JSON.stringify({ courseId, price: 7900, user_id: "ignored" }) }));
+    assert.equal(res.status, 200);
+    const { url, status } = await res.json();
+    assert.equal(status, "open");
+    assert.match(url, /^https:\/\/checkout.stripe.com\/c\/pay\/cs_test_/);
+    const post = calls.find(c => c.path === "/v1/checkout/sessions");
+    assert.equal(post.body.get("line_items[0][price]"), priceId);
+    assert.equal(post.body.get("metadata[course_id]"), courseId);
+    assert.equal(calls.at(-1).path, "/subpath/rest/v1/rpc/mca_bind_checkout");
+    assert.equal(res.headers.get("cache-control"), "no-store");
+    const retried = await (await checkout(request(courseId))).json();
+    assert.equal(retried.url, url);
+    assert.equal(calls.filter(c => c.path === "/v1/checkout/sessions").length, 1);
+  });
+}
+
+test("accepts only authenticated, same-origin requests for an existing course", async t => {
+  const { calls } = fixture(t, { authStatus: 401 });
+  assert.equal((await checkout(request("unknown"))).status, 400);
+  assert.equal((await checkout(request(basic, { body: "{" }))).status, 400);
+  assert.equal((await checkout(request(basic, { body: JSON.stringify({ courseId: basic, padding: "x".repeat(3000) }) }))).status, 400);
+  assert.equal((await checkout(request(basic, { headers: { Origin: "https://other.invalid" } }))).status, 403);
+  assert.equal((await checkout(request(basic, { headers: { "Content-Type": "text/plain" } }))).status, 415);
+  assert.equal((await checkout(request(basic, { headers: { Authorization: "" } }))).status, 401);
+  assert.equal((await checkout(request())).status, 401);
+  assert.equal(calls.length, 1);
+});
+
+test("refuses mismatched mode, missing webhook and reused price IDs", async t => {
+  const { calls } = fixture(t);
+  for (const [key, value, sentOrigin] of [
+    ["MCA_CHECKOUT_ORIGIN", "https://markacentrumacademy.eu", "https://markacentrumacademy.eu"],
+    ["STRIPE_SECRET_KEY", "rk_live_localfixture", origin], ["STRIPE_WEBHOOK_SECRET", "", origin],
+    ["STRIPE_PRICE_RENOVATION", "price_basic120", origin],
+  ]) {
+    const before = process.env[key]; process.env[key] = value;
+    assert.equal((await checkout(request(basic, { headers: { Origin: sentOrigin } }))).status, 503);
+    process.env[key] = before;
+  }
+  assert.ok(calls.every(c => c.path.endsWith("/auth/v1/user")));
+});
+
+for (const condition of ["already_enrolled", "processing"]) {
+  test("does not create a checkout for " + condition, async t => {
+    const { calls } = fixture(t, { prepare: () => ({ status: condition }) });
+    assert.deepEqual(await (await checkout(request())).json(), { status: condition });
+    assert.equal(calls.length, 2);
+  });
+}
+
+test("rejects wrong price, metadata, mode, currency or redirect before exposing a URL", async t => {
+  let adjust = () => ({});
+  const { calls } = fixture(t, { mutate: session => ({ ...session, ...adjust(session) }) });
+  for (const change of [() => ({ amount_total: 7900 }), () => ({ currency: "usd" }),
+    () => ({ livemode: true }), () => ({ mode: "subscription" }),
+    () => ({ metadata: {} }), () => ({ url: "https://other.invalid" })]) {
+    adjust = change;
+    const res = await checkout(request());
+    assert.equal(res.status, 503);
+    assert.deepEqual(await res.json(), { error: "checkout_unavailable" });
+  }
