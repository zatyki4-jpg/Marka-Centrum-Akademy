+  assert.ok(calls.filter(c => c.path.endsWith("/mca_bind_checkout")).length <= 1);
+});
+
+test("does not expose a payment URL until durable binding succeeds", async t => {
+  fixture(t, { bindStatus: 503 });
+  const res = await checkout(request());
+  assert.equal(res.status, 503);
+  assert.deepEqual(await res.json(), { error: "checkout_unavailable" });
+});
+
+test("an expired, verified session can be replaced, and a completed session is never charged again", async t => {
+  const { sessions, calls } = fixture(t);
+  const initial = await (await checkout(request())).json();
