diff --git a/supabase/migrations/20261122234000_mca_stripe_checkout.sql b/supabase/migrations/20261122234000_mca_stripe_checkout.sql
new file mode 100644
index 0000000000000000000000000000000000000000..0d0d4bc19e6f18a715044876b48aeb7f18bee39c
--- /dev/null
+++ b/supabase/migrations/20261122234000_mca_stripe_checkout.sql
@@ -0,0 +1,139 @@
+BEGIN;
+
+-- Mirror the published one-off prices on installations bootstrapped from the older seed.
+UPDATE public.courses SET price_cents=12000,currency='EUR'
+WHERE id IN ('11111111-1111-4111-8111-111111111111','f166433e-5157-4341-9a38-800c62795ebd')
+  AND (price_cents IS DISTINCT FROM 12000 OR upper(currency) IS DISTINCT FROM 'EUR');
+
+CREATE TABLE public.mca_checkout_orders (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  user_id uuid NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
+  course_id uuid NOT NULL REFERENCES public.courses(id),
+  title text NOT NULL,
+  slug text NOT NULL,
+  live boolean NOT NULL,
+  status text NOT NULL DEFAULT 'pending'
+    CHECK (status IN ('pending', 'processing', 'expired', 'failed', 'paid')),
+  session_id text UNIQUE,
+  payment_intent text UNIQUE,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  expires_at timestamptz NOT NULL DEFAULT date_trunc('second',now() + interval '23 hours'),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  paid_at timestamptz
+);
+CREATE UNIQUE INDEX mca_checkout_unfinished
+  ON public.mca_checkout_orders(user_id,course_id,live) WHERE status IN ('pending','processing');
+ALTER TABLE public.mca_checkout_orders ENABLE ROW LEVEL SECURITY;
+REVOKE ALL ON public.mca_checkout_orders FROM PUBLIC, anon, authenticated, service_role;
+
+CREATE FUNCTION public.mca_prepare_checkout(
+  p_user_id uuid, p_course_id uuid, p_live boolean
+) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
+DECLARE
+  selected_course public.courses;
+  sale public.mca_checkout_orders;
+BEGIN
+  IF p_course_id NOT IN ('11111111-1111-4111-8111-111111111111','f166433e-5157-4341-9a38-800c62795ebd')
+     OR p_live IS NULL OR p_user_id IS NULL THEN
+    RAISE EXCEPTION 'invalid_course_purchase';
+  END IF;
+  SELECT * INTO selected_course FROM public.courses
+    WHERE id=p_course_id AND is_published AND price_cents=12000 AND lower(currency)='eur';
+  IF NOT FOUND THEN RAISE EXCEPTION 'course_unavailable'; END IF;
+
+  PERFORM pg_advisory_xact_lock(hashtextextended(p_user_id::text||p_course_id::text,0));
+  IF EXISTS (SELECT 1 FROM public.enrollments WHERE user_id=p_user_id AND course_id=p_course_id
+             AND (promo_access OR (status='active' AND (expiry_date IS NULL OR expiry_date > now()))))
+     OR EXISTS (SELECT 1 FROM public.promo_redemptions r
+                JOIN public.promo_campaigns c ON c.id=r.campaign_id
+                WHERE r.user_id=p_user_id AND c.code='ROOFINGBETA10') THEN
+    RETURN jsonb_build_object('status','already_enrolled');
+  END IF;
+  -- Unbound sessions are never disclosed to a shopper. A bound session is retired
+  -- only after Stripe confirms expiration; delayed payment methods may still settle.
+  UPDATE public.mca_checkout_orders SET status='expired',updated_at=now()
+  WHERE user_id=p_user_id AND course_id=p_course_id AND live=p_live AND status='pending'
+    AND session_id IS NULL AND expires_at<=now();
+  SELECT * INTO sale FROM public.mca_checkout_orders WHERE user_id=p_user_id AND course_id=p_course_id
+    AND live=p_live AND status IN ('pending','processing') FOR UPDATE;
+  IF NOT FOUND THEN
+    INSERT INTO public.mca_checkout_orders(user_id,course_id,title,slug,live)
+    VALUES (p_user_id,p_course_id,selected_course.title,selected_course.slug,p_live) RETURNING * INTO sale;
+  END IF;
+  RETURN jsonb_build_object('status',sale.status,'order_id',sale.id,'session_id',sale.session_id,
+    'title',sale.title,'slug',sale.slug,'created_at',sale.created_at,
+    'expires_at',extract(epoch from sale.expires_at)::bigint);
+END $$;
+
+CREATE FUNCTION public.mca_bind_checkout(p_order_id uuid,p_session_id text)
+RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
+BEGIN
+  IF p_session_id IS NULL OR p_session_id !~ '^cs_(test_|live_)?[A-Za-z0-9]+$' THEN
+    RAISE EXCEPTION 'invalid_session';
+  END IF;
+  UPDATE public.mca_checkout_orders SET session_id=p_session_id, updated_at=now()
+  WHERE id=p_order_id AND (session_id IS NULL OR session_id=p_session_id);
+  IF NOT FOUND THEN RAISE EXCEPTION 'session_conflict'; END IF;
+END $$;
+
+CREATE FUNCTION public.mca_expire_checkout(p_order_id uuid,p_session_id text)
+RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
+BEGIN
+  PERFORM public.mca_bind_checkout(p_order_id,p_session_id);
+  UPDATE public.mca_checkout_orders SET status='expired',updated_at=now()
+  WHERE id=p_order_id AND session_id=p_session_id AND status='pending';
+END $$;
+
+CREATE FUNCTION public.mca_apply_checkout_event(
+  p_order_id uuid,p_user_id uuid,p_course_id uuid,p_session_id text,p_live boolean,
+  p_state text,p_payment_intent text,p_amount integer,p_currency text,p_paid_at timestamptz
+) RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
+DECLARE
+  sale public.mca_checkout_orders;
+BEGIN
+  IF p_state IS NULL OR p_state NOT IN ('paid','processing','failed','expired') THEN
+    RAISE EXCEPTION 'invalid_event_state';
+  END IF;
+  PERFORM pg_advisory_xact_lock(hashtextextended(p_user_id::text||p_course_id::text,0));
+  SELECT * INTO sale FROM public.mca_checkout_orders WHERE id=p_order_id FOR UPDATE;
+  IF NOT FOUND OR sale.user_id IS DISTINCT FROM p_user_id OR sale.course_id IS DISTINCT FROM p_course_id
+     OR sale.live IS DISTINCT FROM p_live THEN RAISE EXCEPTION 'order_mismatch'; END IF;
+  PERFORM public.mca_bind_checkout(p_order_id,p_session_id);
+  IF p_state='paid' AND (p_amount IS DISTINCT FROM 12000 OR lower(p_currency) IS DISTINCT FROM 'eur'
+      OR p_payment_intent IS NULL OR p_payment_intent !~ '^pi_[A-Za-z0-9]+$'
+      OR p_paid_at IS NULL) THEN RAISE EXCEPTION 'payment_mismatch'; END IF;
+  IF sale.status='paid' THEN
+    IF p_state='paid' AND sale.payment_intent IS DISTINCT FROM p_payment_intent THEN
+      RAISE EXCEPTION 'payment_conflict';
+    END IF;
+    RETURN;
+  END IF;
+  IF p_state <> 'paid' THEN
+    -- Late events may arrive after a failure or expiration. Never reopen a terminal order.
+    IF sale.status IN ('pending','processing') AND NOT (sale.status='processing' AND p_state='expired') THEN
+      UPDATE public.mca_checkout_orders SET status=p_state,updated_at=now() WHERE id=sale.id;
+    END IF;
+    RETURN;
+  END IF;
+  -- A paid course has lifetime access immediately, including its materials after certification.
+  INSERT INTO public.enrollments AS e (user_id,course_id,status,activation_date,expiry_date,promo_access)
+  VALUES (sale.user_id,sale.course_id,'active',p_paid_at,NULL,false)
+  ON CONFLICT (user_id,course_id) DO UPDATE
+    SET status='active',
+        activation_date=CASE WHEN e.status='active' AND (e.expiry_date IS NULL OR e.expiry_date>p_paid_at)
+                             THEN e.activation_date ELSE EXCLUDED.activation_date END,
+        expiry_date=NULL;
+  UPDATE public.mca_checkout_orders SET status='paid',payment_intent=p_payment_intent,
+    paid_at=p_paid_at,updated_at=now() WHERE id=sale.id;
+END $$;
+
+REVOKE ALL ON FUNCTION public.mca_prepare_checkout(uuid,uuid,boolean),
+  public.mca_bind_checkout(uuid,text), public.mca_expire_checkout(uuid,text),
+  public.mca_apply_checkout_event(uuid,uuid,uuid,text,boolean,text,text,integer,text,timestamptz)
+  FROM PUBLIC,anon,authenticated,service_role;
+GRANT EXECUTE ON FUNCTION public.mca_prepare_checkout(uuid,uuid,boolean),
+  public.mca_bind_checkout(uuid,text), public.mca_expire_checkout(uuid,text),
+  public.mca_apply_checkout_event(uuid,uuid,uuid,text,boolean,text,text,integer,text,timestamptz)
+  TO service_role;
+NOTIFY pgrst, 'reload schema';
+COMMIT;
