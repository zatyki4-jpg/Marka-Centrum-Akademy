+
+test("the Play launch context survives navigation and sign-in; Android browser checkout stays available", t => {
+  let referrer = "android-app://eu.markacentrumacademy.app";
+  const storage = new Map();
+  for (const [key, value] of Object.entries({
+    window: { matchMedia: () => ({ matches: false }) }, document: { get referrer() { return referrer; } },
+    navigator: { userAgent: "Android" }, sessionStorage: { getItem: k => storage.get(k), setItem: (k,v) => storage.set(k,v) },
+  })) {
+    const original = Object.getOwnPropertyDescriptor(globalThis, key);
