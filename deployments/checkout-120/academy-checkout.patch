diff --git a/src/lib/mca-checkout.server.ts b/src/lib/mca-checkout.server.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3f1bc20c10a97469cb0bd248f726ac95544014a6
--- /dev/null
+++ b/src/lib/mca-checkout.server.ts
@@ -0,0 +1,133 @@
+import { mcaRpc } from "./mca-rpc.server.ts";
+
+const basic = "11111111-1111-4111-8111-111111111111";
+const renovation = "f166433e-5157-4341-9a38-800c62795ebd";
+const canonicalOrigin = "https://markacentrumacademy.eu";
+
+interface Reservation {
+  status: "already_enrolled" | "pending" | "processing";
+  order_id: string;
+  session_id: string | null;
+  expires_at: number;
+  slug: string;
+}
+interface StripeSession {
+  id: string;
+  url: string | null;
+  mode: string;
+  livemode: boolean;
+  status: "open" | "complete" | "expired";
+  client_reference_id: string;
+  metadata: Record<string, string>;
+  amount_total: number;
+  currency: string;
+}
+
+async function readCourseId(request: Request): Promise<string | null> {
+  if (!request.body || Number(request.headers.get("Content-Length")) > 2048) return null;
+  let size = 0;
+  const stream = request.body.pipeThrough(new TransformStream<Uint8Array, Uint8Array>({
+    transform(chunk, controller) {
+      size += chunk.byteLength;
+      if (size > 2048) throw new Error("Request too large");
+      controller.enqueue(chunk);
+    },
+  }));
+  const body = await new Response(stream).json().catch(() => null);
+  return body?.courseId === basic || body?.courseId === renovation ? body.courseId : null;
+}
+
+async function authenticatedUser(request: Request): Promise<string | null> {
+  const token = request.headers.get("authorization");
+  if (!token || !/^Bearer [^\s]+$/.test(token)) return null;
+  const url = process.env["SUPABASE_URL"];
+  const key = process.env["SUPABASE_PUBLISHABLE_KEY"];
+  if (!url || !key) throw new Error("Auth unavailable");
+  const response = await fetch(url.replace(/\/+$/, "") + "/auth/v1/user", {
+    headers: { apikey: key, Authorization: token }, redirect: "error", signal: AbortSignal.timeout(10000),
+  });
+  if (response.status === 401 || response.status === 403) return null;
+  if (!response.ok) throw new Error("Auth unavailable");
+  const user = await response.json();
+  return typeof user.id === "string" ? user.id : null;
+}
+
+async function stripeSession(key: string, sessionId: string | null, form?: URLSearchParams, orderId?: string) {
+  const headers: Record<string, string> = { Authorization: `Bearer ${key}` };
+  let path = "/v1/checkout/sessions";
+  if (sessionId) path += "/" + encodeURIComponent(sessionId);
+  if (orderId) headers["Idempotency-Key"] = `mca-course-v1-${orderId}`;
+  const response = await fetch(new URL(path, "https://api.stripe.com"), {
+    method: form ? "POST" : "GET", headers, ...(form ? { body: form } : {}),
+    redirect: "error", signal: AbortSignal.timeout(15000),
+  });
+  if (!response.ok) throw new Error(`Stripe checkout: ${response.status}`);
+  return await response.json() as StripeSession;
+}
+
+const reply = (value: object, status = 200) =>
+  Response.json(value, { status, headers: { "Cache-Control": "no-store" } });
+
+export async function checkout(request: Request): Promise<Response> {
+  try {
+    const origin = process.env["MCA_CHECKOUT_ORIGIN"] ?? canonicalOrigin;
+    const reqOrigin = request.headers.get("Origin");
+    if (!reqOrigin || reqOrigin !== origin) return reply({ error: "forbidden" }, 403);
+    if (!request.headers.get("content-type")?.startsWith("application/json")) return reply({ error: "invalid_input" }, 415);
+    const courseId = await readCourseId(request);
+    if (!courseId) return reply({ error: "invalid_course" }, 400);
+    const userId = await authenticatedUser(request);
+    if (!userId) return reply({ error: "sign_in_required" }, 401);
+
+    const key = process.env["STRIPE_SECRET_KEY"] ?? "";
+    const price = courseId === basic ? process.env["STRIPE_PRICE_BASIC"] : process.env["STRIPE_PRICE_RENOVATION"];
+    const live = /^(sk|rk)_live_/.test(key);
+    if (!/^whsec_\S+$/.test(process.env["STRIPE_WEBHOOK_SECRET"] ?? "") || !/^(sk|rk)_(test|live)_\S+$/.test(key) || !price || !/^price_[A-Za-z0-9]+$/.test(price) ||
+        process.env["STRIPE_PRICE_BASIC"] === process.env["STRIPE_PRICE_RENOVATION"] ||
+        (live && origin !== canonicalOrigin) || (!live && origin === canonicalOrigin)) {
+      return reply({ error: "checkout_unavailable" }, 503);
+    }
+
+    // A rotation after a Stripe-confirmed expiration needs exactly one new reservation.
+    for (let attempt = 0; attempt < 2; attempt++) {
+      const order: Reservation = await mcaRpc<Reservation>("mca_prepare_checkout", {
+        p_user_id: userId, p_course_id: courseId, p_live: live,
+      });
+      if (order.status === "already_enrolled" || order.status === "processing") return reply({ status: order.status });
+      if (order.status !== "pending" || !order.order_id || !order.slug) throw new Error("Invalid order");
+      let session: StripeSession;
+      if (order.session_id) {
+        session = await stripeSession(key, order.session_id);
+      } else {
+        const courseUrl = `${origin}/kurs/${encodeURIComponent(order.slug)}`;
+        const form = new URLSearchParams({
+          mode: "payment", "line_items[0][quantity]": "1", "line_items[0][price]": price,
+          "adaptive_pricing[enabled]": "false", client_reference_id: order.order_id,
+          "metadata[integration]": "mca_courses_v1", "metadata[mca_order_id]": order.order_id,
+          "metadata[user_id]": userId, "metadata[course_id]": courseId,
+          success_url: courseUrl + "?mca_payment=return", cancel_url: courseUrl,
+          expires_at: String(order.expires_at),
+        });
+        session = await stripeSession(key, null, form, order.order_id);
+      }
+      if (!/^cs_/.test(session.id) || session.mode !== "payment" || session.livemode !== live ||
+          session.client_reference_id !== order.order_id || session.metadata?.["mca_order_id"] !== order.order_id ||
+          session.metadata?.["integration"] !== "mca_courses_v1" ||
+          session.metadata?.["course_id"] !== courseId || session.metadata?.["user_id"] !== userId) throw new Error("Checkout binding mismatch");
+      if (session.status !== "expired" && (session.amount_total !== 12000 || session.currency !== "eur")) throw new Error("Checkout price mismatch");
+      if (!order.session_id) await mcaRpc("mca_bind_checkout", { p_order_id: order.order_id, p_session_id: session.id });
+      if (session.status === "expired") {
+        await mcaRpc("mca_expire_checkout", {p_order_id: order.order_id, p_session_id: session.id});
+        continue;
+      }
+      if (session.status === "complete") return reply({ status: "processing" });
+      if (session.status !== "open" || !session.url || new URL(session.url).origin !== "https://checkout.stripe.com") throw new Error("Invalid checkout URL");
+      return reply({ status: "open", url: session.url });
+    }
+  } catch (error) {
+    // Never log a Stripe response body, token, supplied request body, or private checkout URL.
+    const message = error instanceof Error ? error.message : "";
+    console.error("Academy checkout failed", /^(Academy RPC mca_[a-z_]+: \d+|Stripe checkout: \d+)$/.test(message) ? message : "request unavailable");
+  }
+  return reply({ error: "checkout_unavailable" }, 503);
+}
diff --git a/src/lib/mca-purchase-surface.ts b/src/lib/mca-purchase-surface.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6b01e6a76a025ae9b06a622040d512c53494f876
--- /dev/null
+++ b/src/lib/mca-purchase-surface.ts
@@ -0,0 +1,14 @@
+// TWA starts at the same URL as the public website. Keep the launch context
+// for same-tab navigation, including Supabase's full-page sign-in return.
+export function isPlayPurchaseSurface(): boolean {
+  if (typeof window === "undefined") return true;
+  const fromPlay = /^android-app:\/\/eu\.markacentrumacademy\.app(?:\/|$)/.test(document.referrer);
+  const standaloneAndroid = /Android/i.test(navigator.userAgent) &&
+    (window.matchMedia("(display-mode: standalone)").matches || window.matchMedia("(display-mode: fullscreen)").matches);
+  try {
+    if (fromPlay || standaloneAndroid) sessionStorage.setItem("mca-play-session", "1");
+    return fromPlay || standaloneAndroid || sessionStorage.getItem("mca-play-session") === "1";
+  } catch {
+    return fromPlay || standaloneAndroid;
+  }
+}
diff --git a/src/lib/mca-rpc.server.ts b/src/lib/mca-rpc.server.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e108f3b7bb48880658c1b20797083d0c25183ed4
--- /dev/null
+++ b/src/lib/mca-rpc.server.ts
@@ -0,0 +1,14 @@
+/** Private, service-role-only calls. Never import into a browser module. */
+export async function mcaRpc<T>(name: string, params: Record<string, unknown>): Promise<T> {
+  const url = process.env["SUPABASE_URL"];
+  const key = process.env["SUPABASE_SERVICE_ROLE_KEY"];
+  if (!url || !key || !/^mca_[a-z_]+$/.test(name)) throw new Error("Academy RPC configuration unavailable");
+  const headers: Record<string, string> = { apikey: key, "Content-Type": "application/json" };
+  if (!key.startsWith("sb_secret_")) headers["Authorization"] = `Bearer ${key}`;
+  const response = await fetch(url.replace(/\/+$/, "") + "/rest/v1/rpc/" + name, {
+    method: "POST", headers, body: JSON.stringify(params), redirect: "error", signal: AbortSignal.timeout(10000),
+  });
+  if (!response.ok) throw new Error(`Academy RPC ${name}: ${response.status}`);
+  const body = await response.text();
+  return (body ? JSON.parse(body) : null) as T;
+}
diff --git a/src/lib/mca-webhook.server.ts b/src/lib/mca-webhook.server.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5b123e0cfe909f9f5c6922778cdc6f95b6a0a9a4
--- /dev/null
+++ b/src/lib/mca-webhook.server.ts
@@ -0,0 +1,146 @@
+type PaymentEvent = {
+  p_order_id: string;
+  p_course_id: string;
+  p_user_id: string;
+  p_session_id: string;
+  p_live: boolean;
+  p_state: "expired" | "failed" | "processing" | "paid";
+  p_payment_intent: string | null;
+  p_amount: number | null;
+  p_currency: string | null;
+  p_paid_at: string | null;
+};
+
+type WebhookConfig = {
+  secret: string;
+  stripeKey: string;
+  applyPayment: (event: PaymentEvent) => Promise<unknown>;
+};
+
+const encoder = new TextEncoder();
+const limit = 1024 * 1024;
+const uuid = /^[a-f\d]{8}-(?:[a-f\d]{4}-){3}[a-f\d]{12}$/i;
+
+function response(status: number, message: string) {
+  return Response.json({ ok: status === 200, message }, { status, headers: { "Cache-Control": "no-store" } });
+}
+
+async function readPayload(request: Request) {
+  if (Number(request.headers.get("content-length")) > limit) return null;
+  const reader = request.body?.getReader();
+  if (!reader) return null;
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  try {
+    for (;;) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      size += value.length;
+      if (size > limit) {
+        await reader.cancel();
+        return null;
+      }
+      chunks.push(value);
+    }
+  } finally {
+    reader.releaseLock();
+  }
+  const body = new Uint8Array(size);
+  let offset = 0;
+  for (const chunk of chunks) {
+    body.set(chunk, offset);
+    offset += chunk.length;
+  }
+  return body;
+}
+
+async function verifySignature(raw: Uint8Array, signature: string, secret: string) {
+  const fields = signature.split(",").map(field => field.trim().split("="));
+  const times = fields.filter(([name]) => name === "t");
+  const time = times[0]?.[1];
+  if (times.length !== 1 || !time || !/^\d{1,12}$/.test(time)) return false;
+  if (Math.abs(Math.floor(Date.now() / 1000) - Number(time)) > 300) return false;
+  const values = fields.filter(([name, value]) => name === "v1" && value && /^[a-f\d]{64}$/i.test(value));
+  const prefix = encoder.encode(time + ".");
+  const signed = new Uint8Array(prefix.length + raw.length);
+  signed.set(prefix);
+  signed.set(raw, prefix.length);
+  const key = await crypto.subtle.importKey("raw", encoder.encode(secret), { name: "HMAC", hash: "SHA-256" }, false, ["verify"]);
+  for (const [, hex] of values) {
+    if (!hex) continue;
+    const bytes = Uint8Array.from(hex.match(/../g)!, pair => Number.parseInt(pair, 16));
+    if (await crypto.subtle.verify("HMAC", key, bytes, signed)) return true;
+  }
+  return false;
+}
+
+function record(value: unknown): Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value)
+    ? value as Record<string, unknown> : {};
+}
+
+export async function handleMcaWebhook(request: Request, config: WebhookConfig): Promise<Response> {
+  if (!/^whsec_\S+$/.test(config.secret) || !/^(?:sk|rk)_(?:test|live)_\S+$/.test(config.stripeKey)) {
+    return response(503, "not_configured");
+  }
+  const signature = request.headers.get("stripe-signature");
+  if (!signature || signature.length > 2048) return response(400, "invalid_signature");
+  const payload = await readPayload(request);
+  if (!payload) return response(413, "invalid_payload_size");
+  if (!await verifySignature(payload, signature, config.secret)) return response(400, "invalid_signature");
+
+  let event;
+  try {
+    event = record(JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(payload)));
+  } catch {
+    return response(400, "invalid_payload");
+  }
+  const type = event["type"];
+  if (type !== "checkout.session.completed" && type !== "checkout.session.async_payment_succeeded"
+    && type !== "checkout.session.async_payment_failed" && type !== "checkout.session.expired") {
+    return response(200, "ignored");
+  }
+  const session = record(record(event["data"])["object"]);
+  const metadata = record(session["metadata"]);
+  if (metadata["integration"] !== "mca_courses_v1") return response(200, "ignored");
+  const live = /^(?:sk|rk)_live_/.test(config.stripeKey);
+  if (event["livemode"] !== live || session["livemode"] !== live || session["mode"] !== "payment" || session["object"] !== "checkout.session") {
+    return response(400, "mode_mismatch");
+  }
+  const orderId = metadata["mca_order_id"], userId = metadata["user_id"], courseId = metadata["course_id"];
+  if (typeof orderId !== "string" || !uuid.test(orderId) || session["client_reference_id"] !== orderId
+    || typeof userId !== "string" || !uuid.test(userId) || typeof courseId !== "string" || !uuid.test(courseId)
+    || typeof session["id"] !== "string" || !/^cs_(?:(?:live|test)_)?[A-Za-z0-9]+$/.test(session["id"])) {
+    return response(400, "invalid_order");
+  }
+  let state: PaymentEvent["p_state"];
+  if (type === "checkout.session.expired") {
+    if (session["status"] !== "expired") return response(400, "invalid_session_status");
+    state = "expired";
+  } else {
+    if (session["status"] !== "complete") return response(400, "invalid_session_status");
+    if (type === "checkout.session.async_payment_failed") state = "failed";
+    else if (session["payment_status"] === "paid") state = "paid";
+    else if (type === "checkout.session.completed" && session["payment_status"] === "unpaid") state = "processing";
+    else return response(400, "invalid_payment_status");
+  }
+  const paid = state === "paid";
+  if (paid && (session["amount_total"] !== 12000 || session["currency"] !== "eur"
+    || typeof session["payment_intent"] !== "string" || !/^pi_[A-Za-z0-9]+$/.test(session["payment_intent"])
+    || typeof event["created"] !== "number" || !Number.isSafeInteger(event["created"]) || event["created"] < 1
+    || event["created"] > Math.floor(Date.now() / 1000) + 300)) return response(400, "payment_mismatch");
+
+  try {
+    await config.applyPayment({
+      p_order_id: orderId, p_user_id: userId, p_course_id: courseId, p_session_id: session["id"],
+      p_state: state, p_live: live, p_payment_intent: paid ? session["payment_intent"] as string : null,
+      p_currency: paid ? "eur" : null, p_amount: paid ? 12000 : null,
+      p_paid_at: paid ? new Date((event["created"] as number) * 1000).toISOString() : null,
+    });
+    return response(200, "accepted");
+  } catch {
+    // A transient database error must be retried by Stripe. Do not log personal data from events.
+    console.error("mca_stripe_fulfillment_failed", { orderId, type });
+    return response(503, "retry");
+  }
+}
