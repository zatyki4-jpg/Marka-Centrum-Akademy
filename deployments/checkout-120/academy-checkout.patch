+import { createHmac } from 'node:crypto';
+import { checkout } from '../src/lib/mca-checkout.server.ts';
+import { mcaRpc } from '../src/lib/mca-rpc.server.ts';
+import { handleMcaWebhook } from '../src/lib/mca-webhook.server.ts';
+import { PGlite } from '@electric-sql/pglite';
+
+const user='ab000000-0000-4000-a000-000000000001';
+const basic='11111111-1111-4111-8111-111111111111';
+const reno='f166433e-5157-4341-9a38-800c62795ebd';
+const grantAt=new Date().toISOString();
+
+async function database(t){
