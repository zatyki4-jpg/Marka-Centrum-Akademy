+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHmac } from 'node:crypto';
+import { handleMcaWebhook } from '../src/lib/mca-webhook.server.ts';
+
+const order = 'aabbccdd-1234-4521-9123-112233445566';
+const course = '11111111-1111-4111-8111-111111111111';
+const user = 'ffbbccdd-1234-4521-9123-112233445566';
+const now = Math.floor(Date.now()/1000);
+const endpointSecret = 'whsec_local_fixture';
+const session = {
+  id:'cs_test_a1test',object:'checkout.session',livemode:false,mode:'payment',status:'complete',
+  payment_status:'paid',amount_total:12000,currency:'eur',payment_intent:'pi_test',
+  client_reference_id:order, metadata:{ integration:'mca_courses_v1', mca_order_id:order, user_id:user, course_id:course },
+};
+
+async function deliver({changes={},type='checkout.session.completed',signedAt=now,wrongKey=false,rawAfterSigning=false,
+                         key='sk_test_fixture',callback=async()=>{},extraVersion=false}={}) {
+  const data={type,livemode:false,created:now,data:{object:{...session,...changes}}};
+  const raw=JSON.stringify(data);
+  const signature=createHmac('sha256',wrongKey?'wrong':endpointSecret).update(signedAt+'.'+raw).digest('hex');
+  const headers={'stripe-signature': 't='+signedAt+','+(extraVersion?'v1='+'0'.repeat(64)+',':'')+'v1='+signature};
+  const request=new Request('https://academy.invalid/api/stripe/webhook',{method:'POST',headers,body:rawAfterSigning?raw+' ':raw});
+  return (await handleMcaWebhook(request,{secret:endpointSecret,stripeKey:key,applyPayment:callback})).status;
+}
+
+test('captures verified successful EUR 120 payment with the authenticated order binding', async()=>{
+  const captured=[];
+  assert.equal(await deliver({extraVersion:true,callback:async p=>captured.push(p)}),200);
+  assert.deepEqual(captured,[{p_order_id:order,p_user_id:user,p_course_id:course,p_session_id:session.id,
+    p_state:'paid',p_live:false,p_amount:12000,p_currency:'eur',p_payment_intent:'pi_test',p_paid_at:new Date(now*1000).toISOString()}]);
+});
+
+test('rejects signature mismatch, stale or future signatures, modified bytes, mode and financial mismatches', async()=>{
+  const cases=[{wrongKey:true},{rawAfterSigning:true},{signedAt:now-600},{signedAt:now+600},
+    {key:'sk_live_fixture'}, {changes:{client_reference_id:user}}, {changes:{currency:'usd'}},
+    {changes:{amount_total:11999}}, {changes:{amount_total:12100}}, {changes:{payment_intent:null}},
+    {changes:{payment_status:'no_payment_required'}}, {changes:{mode:'subscription'}}];
+  for(const input of cases) {
+    let called=false;
+    assert.equal(await deliver({...input,callback:async()=>{called=true}}),400);
+    assert.equal(called,false);
+  }
+});
+
+test('accepts verified async states without granting access before payment', async()=>{
+  const states=[];
+  const stmts=[['checkout.session.completed',{payment_status:'unpaid'},'processing'],
+    ['checkout.session.async_payment_succeeded',{},'paid'],
+    ['checkout.session.async_payment_failed',{payment_status:'unpaid'},'failed'],
+    ['checkout.session.expired',{status:'expired',payment_status:'unpaid'},'expired']];
+  for(const [type,changes,state] of stmts) {
+    assert.equal(await deliver({type,changes,callback:async p=>states.push(p.p_state)}),200);
+    assert.equal(states.at(-1),state);
+  }
+});
+
+test('ignores unrelated products; retries if storage unavailable',async()=>{
+  let called=false;
+  assert.equal(await deliver({changes:{metadata:{}},callback:async()=>{called=true}}),200);
+  assert.equal(called,false);
+  assert.equal(await deliver({callback:async()=>{throw new Error('temporary')}}),503);
+});
